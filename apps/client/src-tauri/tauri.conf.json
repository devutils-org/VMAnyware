{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VMAnyware",
  "version": "0.1.0",
  "identifier": "dev.vmanyware.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "VMAnyware", "width": 960, "height": 680 }],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": { "active": false }
}
