# Documentation only: VMAnyware does not automatically load dotenv files.
VMANYWARE_PORT=8080
VMANYWARE_DATABASE=vmanyware.sqlite
# Optional server-owned template mapping; no file is loaded by default.
# VMANYWARE_TEMPLATES=/absolute/path/to/templates.yaml
# Configure all three provider values together in your private runtime environment.
# VMANYWARE_PROXMOX_URL=https://pve.example:8006
# VMANYWARE_PROXMOX_TOKEN_ID=reader@pve!vmanyware
# VMANYWARE_PROXMOX_TOKEN_SECRET=
# VMANYWARE_PROXMOX_CA=/path/to/public-cluster-ca.pem
