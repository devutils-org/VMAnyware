# systemd EnvironmentFile syntax. No shell substitution or export statements.
# Keep the configured file root-owned and mode 0600. Never commit actual tokens.
VMANYWARE_PORT=8080
VMANYWARE_DATABASE=/var/lib/vmanyware/vmanyware.sqlite
# REQUIRED: generate a unique 32-256 character control-plane bearer token.
VMANYWARE_ACCESS_TOKEN=
# Writes remain separately opt-in; configure and review the disposable target first.
VMANYWARE_LIFECYCLE_ENABLED=false
VMANYWARE_PROVISIONING_ENABLED=false
VMANYWARE_SNAPSHOTS_ENABLED=false
VMANYWARE_RESTORES_ENABLED=false
VMANYWARE_DELETIONS_ENABLED=false
# Optional verified provider and catalog. Public CA certificate only; never a key.
# VMANYWARE_PROXMOX_URL=https://pve.example.test:8006
# VMANYWARE_PROXMOX_CA=/etc/vmanyware/proxmox-ca.pem
# VMANYWARE_PROXMOX_TOKEN_ID=vmanyware@pve!control-plane
# VMANYWARE_PROXMOX_TOKEN_SECRET=
# VMANYWARE_TEMPLATES=/etc/vmanyware/templates.yaml
